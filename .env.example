# Database (Railway PostgreSQL dan olinadi)
DATABASE_URL=postgresql://user:password@host:port/database

# Session secret (tasodifiy uzun string)
SESSION_SECRET=your-super-secret-session-key-here-min-32-chars

# Super Admin credentials
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=your-secure-password
SUPER_ADMIN_TOKEN_SECRET=your-super-admin-token-secret

# Telegram Bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Eskiz SMS (ixtiyoriy - pullik xizmat)
ESKIZ_EMAIL=your-eskiz-email
ESKIZ_PASSWORD=your-eskiz-password

# Port (Railway avtomatik o'rnatadi)
PORT=5000
